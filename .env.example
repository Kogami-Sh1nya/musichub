APP_NAME=MusicHub API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Docker/PostgreSQL
DATABASE_URL=postgresql+asyncpg://musichub:musichub@db:5432/musichub

# Local development defaults. Replace in production.
JWT_SECRET_KEY=dev-only-change-this-secret-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOKEN_ENCRYPTION_KEY=umw1sK25PNi-n8-rePoz9d5bt-rlmcJvxSt1yz61km4=

BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:3000

# true = no real VK application is required for local REST testing.
# Set false when connecting to a real VK ID application.
VK_MOCK_MODE=true
VK_CLIENT_ID=dev-client
VK_REDIRECT_URI=http://localhost:8000/api/v1/auth/vk/callback
VK_SCOPES=vkid.personal_info email phone
VK_AUTH_URL=https://id.vk.ru/authorize
VK_TOKEN_URL=https://id.vk.ru/oauth2/auth
VK_USERINFO_URL=https://id.vk.ru/oauth2/user_info
VK_API_URL=https://api.vk.com/method
VK_API_VERSION=5.199

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
